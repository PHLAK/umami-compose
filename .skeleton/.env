# ------------------------------------------------------------------------------
# Umami version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# UMAMI_VERSION=3

# ------------------------------------------------------------------------------
# IP and port binding configuration. These bindings will be exposed to the host.
# ------------------------------------------------------------------------------

# UMAMI_PORT=127.0.0.1:3000

# ------------------------------------------------------------------------------
# A unique value for your installation. This should be a long, random value.
# ------------------------------------------------------------------------------

APP_SECRET=

# ------------------------------------------------------------------------------
# The Umami database credentials. Only the password is required when using the
# provided 'postgres' container.
# ------------------------------------------------------------------------------

# DATABASE_HOST=database
# DATABASE_NAME=umami
# DATABASE_USER=umami
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# Volume where database data will be stored. Path may be absolute or relative to
# the 'docker-compose.yaml' file. If left unset, database data will be stored in
# a Docker volume named 'database-data'.
# ------------------------------------------------------------------------------

# DATABASE_VOLUME=database-data

# ------------------------------------------------------------------------------
# File path where database backups will be stored. This path may be absolute or
# relative to the 'docker-compose.yaml' file. If left unset, backups will be
# stored in 'volumes/backups'.
# ------------------------------------------------------------------------------

# DATABASE_BACKUPS_PATH=
